{
  "manifest_version": 3,
  "name": "Kotodama",
  "version": "0.1.0",
  "description": "動画の英語音声をリアルタイムで日本語字幕にします。",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Kotodama",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "いまのタブの翻訳を開始・停止する"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabCapture", "offscreen", "storage", "unlimitedStorage", "activeTab", "scripting"],
  "host_permissions": ["https://api.openai.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
