{
  "name": "kotodama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "動画の英語音声を日本語字幕にし、動画ごとのタイムラインとまとめを保存するChrome拡張",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moguone/kotodama.git"
  },
  "homepage": "https://github.com/moguone/kotodama#readme",
  "bugs": {
    "url": "https://github.com/moguone/kotodama/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
